{
  "name": "@zaubermaerchen/vue3-slick",
  "description": "slick-carousel component for Vue3",
  "keywords": [
    "slick-carousel",
    "vue"
  ],
  "version": "0.2.0",
  "packageManager": "pnpm@12.4.1",
  "license": "MIT",
  "type": "module",
  "main": "dist/slickCompornent.umd.js",
  "module": "dist/slickCompornent.es.js",
  "source": "src/components/Slick.vue",
  "types": "types/lib.d.ts",
  "files": [
    "dist",
    "src",
    "types"
  ],
  "homepage": "https://github.com/zaubermaerchen/vue3-slick#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zaubermaerchen/vue3-slick.git"
  },
  "bugs": {
    "url": "https://github.com/zaubermaerchen/vue3-slick/issues"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run --environment jsdom",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:types": "vue-tsc -p tsconfig.lib.json",
    "prepack": "run-s build build:types",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "jquery": "3.*",
    "vue": "^3.5"
  },
  "dependencies": {
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.1.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/jquery": "^3.5.34",
    "@types/node": "^22.20.4",
    "@types/slick-carousel": "^1.6.40",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "^1.83.0",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.7.0",
    "jquery": "^3.7.1",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "slick-carousel": "^1.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
